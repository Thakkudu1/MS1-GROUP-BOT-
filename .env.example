# Configure real values in BotNix Cloud; never commit secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
OWNER_NUMBERS=
PREFIX=.
WARN_LIMIT=3
STATUS_AUTO_REACT=true
STATUS_AUTO_SEEN=true
SESSION_DIR=/data/session
STATS_FILE=/data/message-counts.json
LOG_LEVEL=silent
# PORT is normally provided automatically by the hosting platform.
