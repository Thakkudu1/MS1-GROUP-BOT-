# Configure real values in BotNix Cloud; never commit secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
OWNER_NUMBERS=
PREFIX=.
WARN_LIMIT=3
STATUS_AUTO_REACT=true
STATUS_AUTO_SEEN=true
SESSION_DIR=./session
STATS_FILE=./message-counts.json
LOG_LEVEL=silent
# Optional cloned-voice replies (keep the real key only in hosting environment variables)
SARVAM_API_KEY=
SARVAM_VOICE_ID=
VOICE_LANGUAGE=ml-IN
VOICE_REPLIES=true
